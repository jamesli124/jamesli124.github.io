---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { photoMeta, type PhotoMeta } from '../data/photos';
import { checkPhotoMetadata } from '../lib/photo-check';

/**
 * The gallery is driven by the *filesystem*, not by a list: every image in
 * `src/photos/` is published. `src/data/photos.ts` only layers on captions and
 * ordering. Adding a photograph is therefore a one-file commit.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,avif}',
  { eager: true }
);

interface Photo extends PhotoMeta {
  slug: string;
  image: ImageMetadata;
  /** A large, single-format URL used only by the lightbox. */
  full: string;
}

const photos: Photo[] = await Promise.all(
  Object.entries(files).map(async ([path, mod]) => {
    const slug = path.split('/').pop()!.replace(/\.[^.]+$/, '');
    const image = mod.default;
    const full = await getImage({
      src: image,
      width: Math.min(image.width, 2000),
      format: 'webp',
      quality: 82,
    });
    return { slug, image, full: full.src, ...(photoMeta[slug] ?? {}) };
  })
);

// `order` wins if present; otherwise newest first; filename breaks ties so the
// build stays deterministic.
photos.sort((a, b) => {
  if (a.order !== undefined || b.order !== undefined) {
    return (a.order ?? Infinity) - (b.order ?? Infinity);
  }
  if (a.date && b.date && a.date !== b.date) return a.date < b.date ? 1 : -1;
  return a.slug.localeCompare(b.slug);
});

checkPhotoMetadata(photos, Object.keys(photoMeta), import.meta.env.DEV);

const formatDate = (iso?: string) =>
  iso ? new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : undefined;
---

<Base title="Photography" description="A selection of photographs.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">Photography</h1>
      <p class="lede prose">
        Mostly made on foot, mostly on the way to somewhere else. Click any frame to enlarge;
        arrow keys and swipe move between them.
      </p>
    </header>

    {
      photos.length === 0 ? (
        <p class="empty">
          No photographs yet. Drop web-ready JPEGs into <code>src/photos/</code> and they will
          appear here on the next build.
        </p>
      ) : (
        <div class="gallery">
          {photos.map((photo) => (
            <figure class:list={['shot', photo.feature && 'is-feature']}>
              <button
                type="button"
                class="shot-btn"
                data-photo
                data-full={photo.full}
                data-alt={photo.alt ?? ''}
                data-caption={photo.caption ?? ''}
                data-location={photo.location ?? ''}
                data-date={formatDate(photo.date) ?? ''}
                aria-label={`Enlarge: ${photo.alt ?? photo.slug}`}
              >
                <Image
                  src={photo.image}
                  alt={photo.alt ?? ''}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 46vw, 30vw"
                  loading="lazy"
                  decoding="async"
                />
              </button>
              {(photo.caption || photo.location) && (
                <figcaption>
                  {photo.caption ?? photo.location}
                  {photo.date && <span class="when"> · {formatDate(photo.date)}</span>}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )
    }
  </div>

  <Lightbox />
</Base>

<style>
  .page-head {
    padding-bottom: 2.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .page-head .display {
    margin-bottom: 1rem;
  }

  .page-head .lede {
    margin: 0;
  }

  /* Multi-column masonry: photographs keep their own aspect ratio instead of
     being cropped into a uniform grid, which matters more for photography
     than tidy rows do. */
  .gallery {
    columns: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery {
      columns: 3;
      column-gap: 1.75rem;
    }
  }

  .shot {
    margin: 0 0 1.25rem;
    break-inside: avoid;
  }

  @media (min-width: 64rem) {
    .shot {
      margin-bottom: 1.75rem;
    }
  }

  /* A featured photograph runs the full width across all columns. */
  .shot.is-feature {
    column-span: all;
  }

  .shot-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .shot-btn :global(img) {
    width: 100%;
    height: auto;
    transition: opacity var(--transition), transform 240ms ease;
  }

  .shot-btn:hover :global(img) {
    opacity: 0.9;
    transform: scale(1.012);
  }

  figcaption {
    margin-top: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--ink-muted);
  }

  .when {
    color: var(--ink-faint);
  }

  .empty {
    padding: 3rem 0;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--accent-soft);
    padding: 0.1em 0.4em;
  }
</style>
