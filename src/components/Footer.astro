---
import { site, socials, emailDisplay } from '../data/site';
import Seal from './Seal.astro';
import { externalAttrs, isExternal } from '../lib/links';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <Seal size={34} class="footer-seal" />
    <ul class="links">
      <li class="email">{emailDisplay}</li>
      {
        socials.map((s) => (
          <li>
            <a href={s.href} {...externalAttrs(s.href)}>
              {s.label}
              {isExternal(s.href) && <span class="visually-hidden"> (opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="colophon">
      © {year} {site.name}. Built with Astro, set in Newsreader, hosted on GitHub Pages.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.75rem 2.5rem;
  }

  .footer-seal {
    opacity: 0.9;
  }

  .links {
    margin-right: auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .email {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .links a {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  .colophon {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    color: var(--ink-faint);
  }
</style>
